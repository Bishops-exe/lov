{
  arrowParens: "always",
  bracketSameLine: false,
  bracketSpacing: true,
  embeddedLanguageFormatting: "auto",
  endOfLine: "lf",
  semi: true,
  useTabs: false,
  editorconfig: false,
  jsxSingleQuote: false,
  singleQuote: false,
  singleAttributePerLine: false,
  cursorOffset: -1,
  htmlWhitespaceSensitivity: "css",
  insertPragma: false,
  parser: "babel-ts",
  printWidth: 80,
  quoteProps: "as-needed",
  trailingComma: "es5",
  proseWrap: "preserve",
  tabWidth: 2,
  requirePragma: false,
  vueIndentScriptAndStyle: false
}